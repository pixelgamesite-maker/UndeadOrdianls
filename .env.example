# ─────────────────────────────────────────────────────────────
# Undead Ordinals — frontend environment
# Copy to `.env` for local dev. In Railway, set these as variables
# on the service. They are baked in at BUILD time (Vite), so after
# changing them you must rebuild/redeploy — not just restart.
# ─────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase ANON (public) key — safe to ship to the browser.
# NEVER put the service_role key here; that lives only in the
# Edge Function's secrets (see supabase/README.md).
VITE_SUPABASE_ANON_KEY=
